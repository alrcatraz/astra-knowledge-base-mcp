# Python build artifacts
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/
.venv

# Code indexing cache (IDE / agent tools)
.codegraph/
.graphlint/

# IDE
.idea/
.vscode/
*.swp

# Environment config — contains API keys
.env
.env.*
*.env

# Hermes skill symlinks
skills/

# Runtime provider config (local endpoints/keys) — private, not published.
# Public templates live in config/*.example (neutral example ports/hosts).
config/*.conf
scripts/*.conf

# Backup files — never commit
*.bak

# Planning docs — internal roadmaps, architecture notes, interop specs.
# NOT pushed to the public repo (may reference private services/hosts).
docs/
